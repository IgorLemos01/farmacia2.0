# ─────────────────────────────────────────────────────────────────────────────
# FARMÁCIA COUTO — Variáveis de ambiente do backend
# Copie para backend/.env e preencha. O .env nunca deve ser commitado.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados: "mssql" (SQL Server — padrão) ou "mysql"
DB_TYPE=mssql
DB_HOST=localhost
DB_NAME=farmacia_couto
# Porta: 1433 (SQL Server) ou 3306 (MySQL). Se vazio, usa o padrão do tipo.
DB_PORT=

# SQL Server: "yes" usa a autenticação do Windows (sem usuário/senha).
# Para usar usuário e senha, coloque "no" e preencha DB_USER e DB_PASSWORD.
DB_TRUSTED_CONNECTION=yes
DB_DRIVER=ODBC Driver 18 for SQL Server

# Usuário e senha (obrigatórios no MySQL ou no SQL Server sem autenticação do Windows)
DB_USER=
DB_PASSWORD=

# Segredo para assinar os tokens JWT — OBRIGATÓRIO em produção.
# Gere um com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Quantas horas o login dura antes de pedir a senha de novo (padrão: 8).
JWT_EXPIRES_HOURS=8

# Origens (sites) autorizadas a chamar a API, separadas por vírgula.
# Inclua o domínio onde o frontend estiver publicado.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ambiente: development ou production
FLASK_ENV=development
