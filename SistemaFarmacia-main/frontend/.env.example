# Endereço da API Flask (inclua o /api no final).
# Se ficar vazio, o sistema roda em MODO DEMONSTRAÇÃO, com dados fictícios
# guardados apenas no navegador e sem login.
VITE_API_URL=http://localhost:5000/api
